# Copy to .env and fill in. .env is gitignored; this template is not.
#
# node's `pg` wants `postgresql://`, not SQLAlchemy's `postgresql+asyncpg://`.
# Azure Postgres requires SSL. Use `sslmode=verify-full` rather than `require`:
# pg treats them the same today, but `require` becomes weaker in pg v9.

# ---------------------------------------------------------------------------
# What the app uses. This is the LEAST-PRIVILEGE role: CRUD on the rung
# database and nothing else — no DDL, no other databases, no role creation.
# The API, the seed, the backups, and every test connect as this.
#
# Keeping the conventional name for the safe URL means the safe thing is what
# you get by default, and reaching for admin is a visible choice.
#
# `npm run db:create` reads the role name and password straight out of this
# URL, so this is the only place either one lives. To rotate: change it here,
# re-run db:create, then `npm run db:verify-role`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://rung_app:<pick-a-strong-password>@<server>.postgres.database.azure.com:5432/rung?sslmode=verify-full

# ---------------------------------------------------------------------------
# Admin. Needed for exactly two things:
#   npm run db:create    — creates the database and the rung_app role
#   npm run db:migrate   — the only thing that needs DDL
# Nothing else references this, and the app must never use it. Point it at the
# `rung` database; db:create swaps to `postgres` itself where it has to.
# ---------------------------------------------------------------------------
ADMIN_DATABASE_URL=postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/rung?sslmode=verify-full

# HMAC key for the session cookie (>= 32 chars). Rotating it signs everyone
# out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<generate-one>

# Where the SPA is served from; used to build invite links.
APP_BASE_URL=http://localhost:5173
