# Copy to .env and fill in. .env is gitignored; this template is not.
#
# node's `pg` wants `postgresql://`, not SQLAlchemy's `postgresql+asyncpg://`.
# Azure Postgres requires SSL. Use `sslmode=verify-full` rather than `require`:
# pg treats them the same today, but `require` becomes weaker in pg v9.

# Admin connection to the `postgres` maintenance database. Used only by
# `npm run db:create` to create the database and the app role.
ADMIN_DATABASE_URL=postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/postgres?sslmode=verify-full

# What migrations run as. Needs DDL rights.
DATABASE_URL=postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/rung?sslmode=verify-full

# Least-privilege role the API connects as. `npm run db:create` creates it
# using APP_DB_PASSWORD; verify the boundary with `npm run db:verify-role`.
APP_DB_PASSWORD=<pick-a-strong-one>
APP_DATABASE_URL=postgresql://rung_app:<same-password>@<server>.postgres.database.azure.com:5432/rung?sslmode=verify-full

# HMAC key for the session cookie (>= 32 chars). Rotating it signs everyone
# out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<generate-one>

# Where the SPA is served from; used to build invite links.
APP_BASE_URL=http://localhost:5173
