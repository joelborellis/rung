{
  "name": "rung",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Scenario Review Studio — clinician review app for the Handrail safety eval suite",
  "scripts": {
    "start": "node scripts/dev-all.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:deploy": "npm run build && npm run build:server && node scripts/package-deploy.mjs",
    "preview": "vite preview",
    "test": "node scripts/check-import-boundary.mjs && node scripts/check-db-privileges.mjs && vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc -b --noEmit",
    "check:boundary": "node scripts/check-import-boundary.mjs",
    "check:privileges": "node scripts/check-db-privileges.mjs",
    "api:dev": "tsx watch --env-file=.env api/src/server.ts",
    "db:create": "node db/create-database.mjs",
    "db:migrate": "node db/run-migrations.mjs",
    "db:seed": "node db/seed.mjs",
    "db:smoke": "node db/smoke.mjs",
    "db:verify-role": "node db/verify-app-role.mjs",
    "db:inspect": "node db/inspect.mjs",
    "db:verify-canon": "node db/verify-canon-bytes.mjs",
    "db:status": "node db/status.mjs",
    "db:backup": "node db/backup.mjs",
    "db:import-files": "node db/import-review-files.mjs",
    "e2e:blind": "node db/e2e-blind.mjs",
    "e2e:sync": "node db/e2e-sync.mjs",
    "e2e:owner": "node db/e2e-owner.mjs",
    "e2e:browser": "node db/smoke-browser.mjs",
    "e2e:batches": "node db/e2e-batches.mjs",
    "e2e:import": "node db/e2e-import.mjs",
    "e2e:no-review": "node db/e2e-owner-no-review.mjs",
    "e2e": "node db/e2e-blind.mjs && node db/e2e-sync.mjs && node db/e2e-owner.mjs && node db/e2e-owner-no-review.mjs && node db/e2e-import.mjs && node db/e2e-batches.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
